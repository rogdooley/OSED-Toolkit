@echo off
REM install.bat - Set up the exam bundle on the Windows exam box
REM
REM Run from the exam_bundle directory:
REM   cd C:\exam\exam_bundle
REM   install.bat
REM
REM This installs keystone-engine from the bundled wheels (no internet needed).

echo [*] OSED Exam Bundle Installer
echo.

REM Check Python is available
python --version >NUL 2>&1
if %ERRORLEVEL% NEQ 0 (
    python3 --version >NUL 2>&1
    if %ERRORLEVEL% NEQ 0 (
        echo [-] Python not found in PATH.
        echo     Try: where python
        echo     Or check C:\Python3* or C:\Users\*\AppData\Local\Programs\Python
        exit /b 1
    )
    set PYTHON=python3
) else (
    set PYTHON=python
)

echo [+] Found:
%PYTHON% --version

REM Install keystone from local wheels
echo.
echo [*] Installing keystone-engine from bundled wheels...
%PYTHON% -m pip install --no-index --find-links=wheels keystone-engine 2>NUL
if %ERRORLEVEL% NEQ 0 (
    echo [-] Wheel install failed. Trying with --user flag...
    %PYTHON% -m pip install --no-index --find-links=wheels --user keystone-engine
)

REM Verify
echo.
echo [*] Verifying keystone...
%PYTHON% -c "from keystone import Ks, KS_ARCH_X86, KS_MODE_32; ks = Ks(KS_ARCH_X86, KS_MODE_32); enc, _ = ks.asm('nop'); print('[+] Keystone OK: nop =', bytes(enc).hex())"
if %ERRORLEVEL% NEQ 0 (
    echo [-] Keystone verification failed.
    echo     The wheels may not match your Python version.
    echo     Check: %PYTHON% --version
    echo     Available wheels:
    dir /b wheels\*.whl
    exit /b 1
)

echo.
echo [+] Setup complete. Available tools:
echo     badchars\badchar_auto.py  - Automated bad character discovery
echo     tools\recon.exe           - PE triage and analysis
echo     tools\tcp_stage_server.py - TCP staging server (run on Kali)
echo.
echo [+] Per-target files (generated by the emitter on Kali):
echo     code_snippet.py  - Keystone assembly, assemble + run
echo     debug_runner.py  - Assembly with line-by-line error scan
echo     test_harness.py  - Load shellcode.bin and run
echo.
echo     Copy these from emitter_out\asm\ after each build.
